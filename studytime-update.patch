diff --git a/src/app/globals.css b/src/app/globals.css
index 984aa93..b484e71 100644
--- a/src/app/globals.css
+++ b/src/app/globals.css
@@ -1,60 +1,49 @@
 @import 'tailwindcss';
 
-/* Dark mode follows the data-theme attribute set from the user's settings. */
-@custom-variant dark (&:where([data-theme='dark'], [data-theme='dark'] *));
-
+/*
+ * Studytime design tokens. Cozy study room.
+ * Warm paper background, soft serif headings, rounded panels.
+ * Two user colors drive everything that is colored:
+ *   --accent  buttons, links, progress, the backdrop pattern
+ *   --glow    the second color of the background wash
+ * They are set on <html> by applyAppearance() in src/lib/appearance.ts,
+ * which also derives --accent-ink and --accent-fill so text stays readable
+ * whatever color is picked.
+ */
 :root {
-  --accent: #7eab58;
-  --bg: #f6f7f2;
-  --surface: #ffffff;
-  --surface-2: #f8fbf6;
-  --surface-3: #eef2eb;
-  --line: #e7ece4;
-  --line-strong: #d6e1d2;
-  --ink: #182c27;
-  --ink-2: #3d5446;
-  --muted: #7b8b80;
-  --brand: #23513c;
-  --brand-hover: #163f2c;
-  --accent-soft: color-mix(in oklab, var(--accent) 16%, white);
-  --accent-ink: color-mix(in oklab, var(--accent) 45%, #10201f);
-  --ok: #2e7343;
-  --ok-soft: #e4f3e5;
-  --warn: #93591a;
-  --warn-soft: #fdf1df;
-  --danger: #b2553a;
-  --danger-soft: #fcefe9;
-  --shadow: 0 1px 2px #1d33240d, 0 6px 20px #1d33240a;
-  color-scheme: light;
-}
+  --accent: #b4532a;
+  --accent-ink: #a14a25;
+  --accent-fill: #b4532a;
+  --glow: #e7b76a;
+  --wash: 22%;
 
-[data-theme='dark'] {
-  --bg: #0f1714;
-  --surface: #18241f;
-  --surface-2: #14201b;
-  --surface-3: #22332a;
-  --line: #2c3d34;
-  --line-strong: #3b5045;
-  --ink: #edf4eb;
-  --ink-2: #c8d8c9;
-  --muted: #9aac9e;
-  --brand: color-mix(in oklab, var(--accent) 62%, #10201a);
-  --brand-hover: color-mix(in oklab, var(--accent) 72%, #10201a);
-  --accent-soft: color-mix(in oklab, var(--accent) 20%, #18241f);
-  --accent-ink: color-mix(in oklab, var(--accent) 55%, white);
-  --ok: #8fd39f;
-  --ok-soft: #1d3a26;
-  --warn: #f2cf93;
-  --warn-soft: #3a2f1c;
-  --danger: #f0a78c;
-  --danger-soft: #3a2620;
-  --shadow: 0 1px 2px #0005;
-  color-scheme: dark;
+  --bg: #f8f2e8;
+  --ink: #2a2420;
+  --ink-2: #4a413a;
+  --muted: #6b6158;
+  --line: #e6dccd;
