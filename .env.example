# Copy this file to .env.local and fill in what you need. Everything is optional.

# ---------- AI (shared key for everyone who uses your site) ----------
# Leave these empty to have each student paste their own free key in Settings → AI tutor.
# Free: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Free (text only): https://console.groq.com/keys
GROQ_API_KEY=
# Free models with a ":free" suffix: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Paid: https://console.anthropic.com
ANTHROPIC_API_KEY=
# Which shared provider to use when several keys are set: gemini | groq | openrouter | anthropic
AI_PROVIDER=gemini
# Strongly recommended when hosting publicly with a shared key: students must enter this code to use it.
AI_ACCESS_CODE=
# Per-visitor limits when the shared key is used
AI_RATE_LIMIT_PER_MIN=15
AI_DAILY_LIMIT=200

# ---------- Storage for circles, classes, leaderboards, shared decks ----------
# Locally, data is saved to .data/studytime.json automatically.
# On Vercel (or any serverless host), add an Upstash Redis database:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
